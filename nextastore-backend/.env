# NextaStore environment configuration
# Keep this file private. For production, prefer your host's secret/environment-variable manager.

NODE_ENV=production
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:gsqnLZJlzJOEIgzYCeulMksCHzFXsQiZ@iriguchi.proxy.rlwy.net:18494/railway?connection_limit=10&pool_timeout=20

# JWT authentication
JWT_SECRET=194b886677bec2e34752e51571272f828d8403a65c43e12360f483dabd22e52e
# "Remember me" ticked → 30 days. In line with common e-commerce practice
# (Amazon/Shopify/Etsy-style storefronts typically land in the 14-30 day
# range for a persistent login).
JWT_REMEMBER_EXPIRES_IN=30d
# "Remember me" unticked → 24 hours, sliding (renewed while the session is
# actively used — see attachRenewedToken in src/middleware.js). 24h is the
# conventional default for a non-persistent web session; it's not meant to
# be reached in practice since sessionStorage already clears this on
# browser close, but caps how long a stale token stays valid if the tab is
# left open on a shared device.
JWT_SESSION_EXPIRES_IN=24h

# Browser origins allowed to call the API
# Add the actual frontend origin(s) here if frontend and API are hosted separately.
# NOTE: start-local.bat serves the frontend from http://localhost:3000 — that
# origin must be in this list or every browser fetch() to the API is blocked
# by CORS before it even reaches the server (this is what "Can't reach the
# server" on the login page was: not the API being down, but the browser
# refusing the cross-origin request because localhost:3000 wasn't allow-listed).
CORS_ORIGIN=http://localhost:3000,https://ligament-marmalade-outdoors.ngrok-free.dev

# Public URLs
PUBLIC_URL=https://ligament-marmalade-outdoors.ngrok-free.dev
FRONTEND_URL=https://ligament-marmalade-outdoors.ngrok-free.dev

# Cloudflare R2
R2_ENDPOINT=https://32d8ff5cc48bfc7bd1da3c4ed8f7ebe0.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=16185259fbd127d9b56532dff84b33b5
R2_SECRET_ACCESS_KEY=00a0b3696190d95353a5c79ed367fb01c7cb19fc232e31b5e25d8658d488de7c
R2_BUCKET_NAME=nextastore
R2_PUBLIC_URL=https://pub-42bfe321467b42c890104266c0a66e0d.r2.dev

