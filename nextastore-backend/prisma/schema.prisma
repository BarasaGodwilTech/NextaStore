// NextaStore production schema.
//
// Design notes (see README.md "Database" section for the full rationale):
//  - storeId is indexed on every store-scoped table — this is the multi-tenant
//    boundary and every query in src/ filters through it.
//  - deletedAt (soft delete) on Store/Product/Order — order history and a
//    store's sales record must survive a product or store being removed.
//  - OrderItem snapshots productName + unitPrice at the moment of purchase.
//    Prices change and products get deleted; an order must never silently
//    reflect today's price for something bought last month.
//  - Order.total and OrderItem.unitPrice are ALWAYS computed server-side from
//    Product.price at write time — never trust a client-supplied price/total.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum FulfillmentMethod {
  delivery
  pickup
}

enum PaymentStatus {
  unpaid
  paid
}

// A user's account type. "buyer" is the default for anyone who signs up to
// shop; "seller" is anyone who owns (or has ever owned) a store. There's no
// "both" value — sellers can always browse/buy too, so gating on role only
// ever needs to ask "is this a seller-only action?", never "is this user
// specifically a buyer?". A buyer becomes a seller in place (see
// POST /user/become-seller) rather than needing a second account.
enum UserRole {
  buyer
  seller
}

enum UserAccountStatus {
  active
  suspended
}

// ---------------------------------------------------------------------------
// STAFF CONSOLE (internal administration).
// Staff are NOT users. A StaffAccount has its own table, its own login, its own
// MFA, its own sessions and its own roles. It has no cart, no store, no orders,
// no messages and no way to sign in to the shopper site, and a shopper account
// has no way into the console. See src/staff/.
// ---------------------------------------------------------------------------
enum StaffStatus {
  invited    // created by another staff member; has not accepted the invite yet
  active
  suspended
}

enum StaffTokenType {
  invite
  password_reset
}

enum ModerationStatus {
  ok
  restricted   // hidden from shoppers by staff (store: not in marketplace/storefront; product: not listed)
}

enum TicketStatus {
  open
  pending     // waiting on the customer
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum TicketAuthorKind {
  customer
  staff
  system
}

enum AdminFollowUpStatus {
  open
  in_progress
  done
  cancelled
}

// Seller subscription (item: paid "verified" badge / SaaS access gate).
// "trial" = the free evaluation window every new store gets automatically;
// "active" = currently paid; "expired" = trial ran out and no payment is on
// file. This column is a best-effort cache for admin/dashboard display —
// the actual enforcement (what's visible on the public marketplace) always
// recomputes live from trialEndsAt/subscriptionPaidUntil so it can never go
// stale even if this column hasn't been refreshed yet. See helpers.js
// subscriptionInfo() / isStoreCurrentlyActive().
enum StoreSubscriptionStatus {
  trial
  active
  expired
}

enum SubscriptionPaymentStatus {
  pending
  approved
  rejected
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // The person's Google account id (the `sub` of a verified Google ID token), once they have used "Continue with Google".
  // Unique, so one Google account can only ever open or link ONE NextaStore account. Null for people who only use a password.
  googleId     String?  @unique
  role         UserRole @default(buyer)
  accountStatus UserAccountStatus @default(active)
  // Bumped on password change, password reset, and "log out everywhere".
  // Every session token carries the tokenVersion it was issued under (see
  // signSessionToken in src/middleware.js); a token whose value no longer
  // matches this column is rejected as TOKEN_REVOKED. Starts at 0, same as
  // every token issued before this column existed, so deploying this alone
  // logs nobody out.
  tokenVersion Int @default(0)
  avatar       String?
  cover        String?
  emailVerifiedAt DateTime?
  // Presence: when this person was last seen connected (see src/presence.js).
  // Only meaningful while they are OFFLINE — while they are online, the live
  // connection is the source of truth and this column is just a slow
  // checkpoint (written at most every few minutes, plus once on disconnect)
  // so a crash or restart never loses more than a few minutes of accuracy.
  // Nullable: null means "never seen", which the UI shows as plain Offline.
  lastActiveAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store?
  storeFollows StoreFollow[]
  productFavorites ProductFavorite[]

  conversationsAsBuyer Conversation[] @relation("BuyerConversations")
  messages             Message[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  ordersAsBuyer        Order[]        @relation("BuyerOrders")
  orderReports         OrderReport[]
  verificationTokens   VerificationToken[]
  // Staff-side records ABOUT this person (never staff identities themselves).
  followUpsAbout       AdminFollowUp[] @relation("FollowUpOwner")
  auditTargetLogs      AdminAuditLog[] @relation("AuditTargetUser")
  supportTickets       SupportTicket[]
  staffNotes           UserNote[]
}


model StaffRole {
  id          String   @id @default(cuid())
  // Stable machine name: 'super_admin', 'support_agent', ... or 'custom_xxx'.
  key         String   @unique
  name        String   @unique
  description String   @default("")
  permissions String[] @default([])
  // Hierarchy. A staff member can only create, edit, suspend or reset staff whose role ranks BELOW their own, and can only
  // hand out roles that rank below their own. Super Admin is 100. See src/staff/permissions.js.
  rank        Int      @default(10)
  // System roles ship with the product: they cannot be edited or deleted from the console.
  isSystem    Boolean  @default(false)
  createdById String?
  createdBy   StaffAccount? @relation("StaffRoleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     StaffAccount[]
  followUps   AdminFollowUp[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StaffAccount {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  passwordHash  String
  jobTitle      String      @default("")
  roleId        String
  role          StaffRole   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status        StaffStatus @default(invited)
  // Forces a new password (and blocks everything else) until it is set. True for migrated admins and after an admin-issued reset.
  mustChangePassword Boolean @default(false)
  passwordChangedAt  DateTime?
  // Two-step verification (TOTP). The secret is stored AES-256-GCM encrypted (src/staff/crypto.js), never in clear.
  // mfaEnabledAt stays null until the first code is confirmed; sign-in is refused until it is set.
  mfaSecretEnc  String?
  mfaEnabledAt  DateTime?
  mfaLastStep   Int?        // last accepted 30-second step: a code can never be used twice
  recoveryCodeHashes String[] @default([])
  // Sensitive-action PIN (6 digits, bcrypt). Set by the person after their first sign-in; asked for before money, access and
  // security changes. pinSetAt stays null until it exists; the console is blocked (except the PIN page) until then.
  pinHash       String?
  pinSetAt      DateTime?
  pinFailed     Int         @default(0)
  pinLockedUntil DateTime?
  failedLogins  Int         @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  // Bumped on password change/reset, MFA reset and "sign out everywhere". Pre-auth challenges carry it.
  tokenVersion  Int         @default(0)
  createdById   String?
  createdBy     StaffAccount?  @relation("StaffCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdStaff  StaffAccount[] @relation("StaffCreator")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sessions      StaffSession[]
  devices       StaffDevice[]
  tokens        StaffToken[]
  createdRoles  StaffRole[]    @relation("StaffRoleCreator")
  auditLogs     AdminAuditLog[] @relation("AuditActor")
  followUpsAssigned AdminFollowUp[] @relation("FollowUpAssignee")
  ticketsAssigned   SupportTicket[]
  ticketMessages    SupportTicketMessage[]
  userNotes         UserNote[]

  @@index([roleId])
  @@index([status])
}

// One row per signed-in browser. The browser holds an opaque random token (httpOnly cookie); only its SHA-256 is stored here, so a
// database leak does not yield usable sessions. Revoking a session is one UPDATE.
model StaffSession {
  id          String   @id @default(cuid())
  staffId     String
  staff       StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  csrfToken   String
  deviceId    String?
  ip          String   @default("")
  userAgent   String   @default("")
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  // Absolute end of life; the idle timeout is checked against lastSeenAt.
  expiresAt   DateTime
  // Last time the person proved themselves again (password or MFA code). Sensitive actions need this to be recent ("step-up").
  reauthAt    DateTime @default(now())
  revokedAt   DateTime?
  revokedReason String?

  @@index([staffId, revokedAt])
  @@index([expiresAt])
}

// A browser the person has verified with their authenticator. It holds an opaque random token in a long-lived httpOnly cookie
// (only its SHA-256 is stored). While trustedUntil is in the future, a normal sign-in from it skips the authenticator code,
// unless the sign-in looks suspicious (see src/staff/risk.js). Revoking it forces the code next time.
model StaffDevice {
  id          String   @id @default(cuid())
  staffId     String
  staff       StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  label       String   @default("")
  userAgent   String   @default("")
  firstIp     String   @default("")
  lastIp      String   @default("")
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  trustedUntil DateTime
  revokedAt   DateTime?

  @@index([staffId, revokedAt])
}

model StaffToken {
  id        String   @id @default(cuid())
  staffId   String
  staff     StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type      StaffTokenType
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([staffId, type])
}

model AdminFollowUp {
  id            String              @id @default(cuid())
  title         String
  note          String              @default("")
  status        AdminFollowUpStatus @default(open)
  dueAt         DateTime?
  relatedUserId String?
  relatedUser   User?               @relation("FollowUpOwner", fields: [relatedUserId], references: [id], onDelete: SetNull)
  assignedToId  String?
  assignedTo    StaffAccount?       @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  adminRoleId   String?
  adminRole     StaffRole?          @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  completedAt   DateTime?

  @@index([status, dueAt])
  @@index([relatedUserId])
  @@index([assignedToId])
}

// Append-only trail of everything staff do (and of every sign-in attempt). actorId is null for events with no known staff member
// (e.g. a failed sign-in for an unknown address); actorLabel keeps a readable "Name <email>" so the trail survives staff changes.
model AdminAuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actor         StaffAccount? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel    String   @default("")
  action        String
  targetType    String
  targetId      String?
  targetUserId  String?
  targetUser    User?    @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  metadata      Json     @default("{}")
  ip            String   @default("")
  userAgent     String   @default("")
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ---- Support desk -----------------------------------------------------------------------------------------------------------
model SupportTicket {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  subject        String
  category       String         @default("general")
  status         TicketStatus   @default(open)
  priority       TicketPriority @default(normal)
  requesterId    String?
  requester      User?          @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  requesterName  String         @default("")
  requesterEmail String         @default("")
  assigneeId     String?
  assignee       StaffAccount?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  relatedOrderId String?
  source         String         @default("web")
  // Answer-by time, from the priority (src/staff/support.js SLA_HOURS). Resolved/closed tickets stop the clock.
  slaDueAt       DateTime?
  firstResponseAt DateTime?
  resolvedAt     DateTime?
  lastMessageAt  DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  messages       SupportTicketMessage[]

  @@index([status, priority])
  @@index([assigneeId, status])
  @@index([requesterId])
  @@index([slaDueAt])
  @@index([lastMessageAt])
}

model SupportTicketMessage {
  id            String           @id @default(cuid())
  ticketId      String
  ticket        SupportTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorKind    TicketAuthorKind
  authorStaffId String?
  authorStaff   StaffAccount?    @relation(fields: [authorStaffId], references: [id], onDelete: SetNull)
  authorName    String           @default("")
  body          String
  // Internal notes are visible to staff only and are never emailed or shown to the customer.
  isInternal    Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([ticketId, createdAt])
}

model CannedReply {
  id          String   @id @default(cuid())
  title       String
  body        String
  // 'reply' (ticket answers), 'email' and 'notification' (messages to accounts / broadcasts). Variables: {{first_name}}, {{name}}, {{staff_name}}.
  kind        String   @default("reply")
  subject     String   @default("")
  category    String   @default("general")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One message sent to many accounts at once (Staff Console > Messages). The row is the receipt: who sent it, to whom, how many.
model Broadcast {
  id          String   @id @default(cuid())
  title       String
  subject     String   @default("")
  body        String
  audience    String   @default("all")        // all | sellers | buyers | new_7d
  channels    String[] @default([])           // in_app | email
  status      String   @default("sending")    // sending | sent | failed
  recipients  Int      @default(0)
  inAppSent   Int      @default(0)
  emailSent   Int      @default(0)
  emailFailed Int      @default(0)
  sentById    String?
  sentByLabel String   @default("")
  createdAt   DateTime @default(now())
  finishedAt  DateTime?

  @@index([createdAt])
}

// Internal staff notes about a shopper or seller account. Never shown to the person.
model UserNote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId   String?
  author     StaffAccount? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String   @default("")
  body       String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// Platform-wide notice shown as a banner on the shopper site while active (see GET /api/announcements/active).
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String   @default("")
  tone        String   @default("info")      // info | warning | success
  audience    String   @default("all")       // all | sellers | buyers
  isActive    Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model Store {
  id           String    @id @default(cuid())
  ownerId      String?   @unique
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  slug         String    @unique
  name         String
  description  String    @default("")
  contactEmail String    @default("")
  phoneNumber  String    @default("")
  // Whether phoneNumber is shown to shoppers on the public store page.
  // Always visible to the owner (serializeStore) and to NextaStore itself
  // for account follow-up — this only gates serializePublicStore. Defaults
  // to false so a store created outside onboarding (or before this column
  // existed) doesn't start out exposing a number nobody chose to publish.
  phonePublic  Boolean   @default(false)
  address      String    @default("")
  theme        String    @default("default")
  layout       String    @default("grid")
  logo         String?
  banner       String?
  // Unified banner system: color + image both live here at the store level,
  // so every page (storefront, dashboard, sub-pages) renders from this one
  // source instead of each page keeping its own copy. #00B074 is the
  // default green for every newly created store.
  bannerColor  String    @default("#00B074")
  district           String @default("")
  detailedDirections String @default("")
  // "lat,lng" string, matching the format the map picker already reads/writes.
  mapCoordinates     String @default("")
  // Kept as JSON (not flattened columns) so the existing frontend's
  // `store.payments.mtnMomo` / `store.seo.title` shape needs zero changes.
  // Starts EMPTY: a new store accepts no payment method until its seller turns
  // one on (onboarding step 3 / Settings). It used to start with MTN MoMo and
  // Airtel Money already on, which marked payments "done" and advertised
  // methods to shoppers that the seller never chose.
  payments     Json      @default("{}")
  seo          Json      @default("{\"title\": \"\", \"description\": \"\", \"keywords\": \"\", \"analyticsId\": \"\"}")
  followers    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  // Draft vs. live. Only onboarding.js's launch() ever sets this to true —
  // every public read (marketplace, search, storefront-by-slug routing)
  // must filter on it. Existing production stores are backfilled to true
  // in the migration (they're already live); only stores created from that
  // point forward start as drafts via the column's DB default.
  isPublished  Boolean   @default(false)
  // Primary seller trust flag. It is true only while a confirmed paid
  // commitment of at least 6 months is active. Higher commitment tiers are
  // exposed through the derived `badges` payload, not a separate rating.
  verified     Boolean   @default(false)
  // The commitment length of the latest approved Seller Pass payment.
  // A public trust badge is earned only from a confirmed commitment of 6+ months.
  badgeCommitmentMonths Int @default(0)

  // Every store gets a free trial window from the moment it's created
  // (DB column default, so this applies no matter which code path creates
  // the store — signup or /user/become-seller — without either needing to
  // set it explicitly). subscriptionPaidUntil is null until the first
  // approved payment. The corrective production migration removes the
  // original rollout's legacy five-year grant from stores with no approved
  // payment.
  subscriptionStatus    StoreSubscriptionStatus @default(trial)
  trialEndsAt           DateTime                @default(dbgenerated("(now() + interval '7 days')"))
  subscriptionPaidUntil DateTime?

  // Staff moderation (Staff Console > Stores). 'restricted' removes the store from every public surface; the owner can still sign in.
  moderationStatus ModerationStatus @default(ok)
  moderationNote   String           @default("")
  moderatedAt      DateTime?
  moderatedBy      String?

  products Product[]
  orders   Order[]
  conversations Conversation[]
  followersRecords StoreFollow[]
  subscriptionPayments SubscriptionPayment[]

  @@index([createdAt])
  // Public store directory (GET /store/public/all): filter on isPublished, order by verified/createdAt or name.
  @@index([isPublished, verified, createdAt])
  @@index([isPublished, name])
  // Also has GIN trigram indexes on name/description/district/address for
  // fast ILIKE '%term%' search at scale — see migration
  // 20260917120000_trigram_search_indexes (Prisma schema syntax can't
  // express a non-default GIN operator class, so it isn't redeclared here).
  //
  // ⚠ THIS ALREADY HAPPENED ONCE: because these indexes only exist as raw
  // SQL and not here, a later `prisma migrate dev` schema diff (migration
  // 20260917123239_init) saw them as "unexpected" and auto-generated a
  // migration that DROPPED 4 of the 6 — silently, with a green migration
  // history, until a corrective migration
  // (20260917190000_restore_trigram_search_indexes) put them back. Before
  // running `prisma migrate dev` again, diff the generated migration.sql
  // for `DROP INDEX ... _trgm_idx` and remove that line if present — don't
  // let it ship. `npm run qa:static` also checks this automatically.
}

model StoreFollow {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
}

// A buyer "liking"/saving a product for later — same shape as StoreFollow.
// Unlike orders or reviews this carries no business logic of its own, it's
// purely a saved-items list (see GET/POST/DELETE /favorites).
model ProductFavorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model Product {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  description   String    @default("")
  price         Decimal   @db.Decimal(12, 2)
  originalPrice Decimal?  @db.Decimal(12, 2)
  // Denormalized: true when originalPrice > price. Prisma's query builder
  // can't compare two columns of the same row in a `where` clause, so
  // without this the /deals endpoint had to pull a working set of rows and
  // filter in JS on every request — fine at demo scale, a real bottleneck
  // once the catalog is large (it also silently returns fewer than 8 deals
  // once discounted products fall outside the top-N pulled). Kept in sync
  // by setOnSale() in helpers.js on every create/update — never set this
  // directly from request payloads.
  onSale        Boolean   @default(false)
  category      String    @default("other")
  images        Json      @default("[]")
  image         String?
  // Small (~480px) variants of `images`, same index-for-index, generated
  // client-side at upload time (see product-form.js's canvas resize) so
  // marketplace/store grids don't have to ship full-resolution photos for a
  // ~200px card (item 5). Falls back to `images`/`image` for any product
  // saved before this existed — see serializeProduct's computed `thumbnail`.
  thumbnails    Json      @default("[]")
  icon          String    @default("fa-box")
  stock         Int       @default(0)
  // 'physical' (bought through the cart, uses stock) | 'service' | 'digital'.
  // Service and digital listings are not bought through the cart: shoppers
  // enquire through Messages. See README "Listing types". serviceArea and
  // serviceDuration are free text, only shown for services.
  listingType     String  @default("physical")
  serviceArea     String  @default("")
  serviceDuration String  @default("")
  sold          Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  // Staff moderation (Staff Console > Products). 'restricted' hides the listing from shoppers; the seller still sees it.
  moderationStatus ModerationStatus @default(ok)
  moderationNote   String           @default("")
  moderatedAt      DateTime?
  moderatedBy      String?

  orderItems OrderItem[]
  conversations Conversation[]
  favoritedBy ProductFavorite[]

  @@index([storeId])
  @@index([storeId, category])
  @@index([storeId, createdAt])
  @@index([storeId, sold])
  @@index([storeId, price])
  @@index([onSale, sold])
  @@index([sold])
  @@index([createdAt])
  @@index([name])
  // Also has GIN trigram indexes on name/description for fast ILIKE
  // '%term%' search at scale — added as raw SQL in migration
  // 20260917120000_trigram_search_indexes since Prisma's schema syntax
  // can't express a non-default GIN operator class. Not redeclared here;
  // don't let `prisma migrate dev`'s schema diff talk you into dropping it.
  //
  // ⚠ THIS ALREADY HAPPENED ONCE — see the matching warning on Store's
  // trigram indexes above for what went wrong and how it was caught.
}

model Order {
  // Short, human-friendly code (e.g. "3F9A1B2C") used as the primary key —
  // the frontend displays order.id directly as the order number.
  id            String      @id
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  // Nullable so pre-existing orders placed before checkout required login
  // still read back fine. Every order created from here on always has one —
  // checkout now requires a buyer to be logged in (see POST /orders/public
  // and item 13), which is also what makes a real "order history" page
  // possible instead of no link back to a buyer account at all.
  buyerId       String?
  buyer         User?       @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  deliveryAddress String @default("")
  fulfillmentMethod FulfillmentMethod @default(delivery)
  paymentMethod String?
  paymentStatus PaymentStatus @default(unpaid)
  flaggedAt DateTime?
  flagReason String?
  // Buyer-initiated cancellation (POST /orders/:id/cancel), distinct from a
  // seller moving an order to 'cancelled' via PUT /:id/status — kept apart
  // so the reason shown to the seller, and the anti-abuse count, only ever
  // reflect cancellations the *buyer* chose to make.
  cancelledAt    DateTime?
  cancelReason   String?
  cancelDetails  String?
  cancelInitiator String?
  total         Decimal     @db.Decimal(12, 2)
  status        OrderStatus @default(pending)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  items OrderItem[]
  reports OrderReport[]

  @@index([storeId])
  @@index([storeId, customerPhone])
  @@index([storeId, createdAt])
  @@index([buyerId])
  @@index([buyerId, cancelInitiator, cancelledAt])
}

model OrderReport {
  id         String   @id @default(cuid())
  orderId    String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime @default(now())

  @@unique([orderId, reporterId])
  @@index([orderId])
  @@index([reporterId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)

  @@index([orderId])
}

// Buyer <-> seller messaging (item 11). One conversation per
// buyer/store/product combination (product optional — a buyer can also
// message a store in general, outside any specific product page). Simple
// polling from the frontend is fine to start; a WebSocket/SSE channel could
// later push new messages instead of the client re-fetching on an interval.
model Conversation {
  id        String    @id @default(cuid())
  buyerId   String
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages Message[]

  // Product-specific threads are unique here. A PostgreSQL partial unique
  // index in the production migration additionally enforces one general
  // (productId IS NULL) thread per buyer/store pair, because Prisma schema
  // syntax cannot express that partial constraint.
  @@unique([buyerId, storeId, productId])
  @@index([storeId])
  @@index([buyerId])
}

// "text" is a normal chat bubble. "product" and "location" are rich
// attachment messages (see item: in-chat product sharing / location
// sharing) — their structured payload lives in `metadata` rather than
// being crammed into `body`, so `body` stays free to hold an optional
// caption the sender typed alongside the attachment.
enum MessageType {
  text
  product
  location
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  type           MessageType  @default(text)
  // Snapshotted attachment payload, shaped by `type`:
  //   product  -> { productId, name, price, image }  (captured at send
  //               time so the bubble still renders correctly even if the
  //               product is later edited, discounted or deleted)
  //   location -> { lat, lng, label }
  //   text     -> always {}
  metadata       Json         @default("{}")
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  // Also has a PARTIAL index — "Message_unread_by_conversation_idx" on
  // (conversationId, senderId) WHERE readAt IS NULL — added in migration
  // 20260918110000_message_unread_perf_index. Prisma schema syntax can't
  // express a partial index's WHERE clause (same limitation noted below for
  // the trigram search indexes), so it's deliberately NOT declared as an
  // @@index here: doing so would describe a full index of the same name to
  // Prisma's drift detection, which would then "fix" the real partial index
  // by replacing it with a full one on the next `prisma migrate dev` —
  // exactly what happened to the trigram indexes once already (see
  // 20260917190000_restore_trigram_search_indexes). Leave this as a
  // migration-only index; `prisma migrate deploy` in production never runs
  // drift detection and is unaffected.
}

// Backing store for the dashboard notification bell (item 12) and the
// account-menu equivalent. Rows are created inline wherever the triggering
// event happens (new order, new message, stock crossing the low-stock
// threshold) rather than computed on read, so "unread" has a real,
// persistent meaning instead of being derived from timestamps every time.
enum NotificationType {
  new_order
  new_message
  low_stock
  subscription
  new_product
  store_live
  growth
  staff_message
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String           @default("")
  link      String           @default("")
  readAt    DateTime?
  // Two-tier state: `readAt` is the per-item "unread" indicator inside the
  // dropdown/list and only clears when that specific notification is opened.
  // `acknowledgedAt` drives only the exterior bell badge count and clears in
  // bulk the moment the bell is opened (PUT /notifications/acknowledge),
  // independent of whether any individual item has been read yet.
  acknowledgedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, readAt])
  @@index([userId, acknowledgedAt])
  @@index([userId, createdAt])
}

// One row per browser/device the person has granted push permission on and
// the service worker successfully subscribed (see js/push.js,
// service-worker.js, and POST /api/push/subscribe). A person who reads
// NextaStore on their phone and their laptop has two rows here, and gets the
// notification on both -- there's deliberately no "one subscription per
// user" constraint. `endpoint` is the whole identity of a subscription (the
// browser's push service assigns a fresh one if it ever needs to rotate it),
// so it's the natural unique key and upsert target rather than the (id) pk.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

// A seller's self-reported mobile money payment toward their subscription.
// NextaStore doesn't hold an MTN/Airtel merchant integration yet, so this is
// deliberately a "submit reference code -> admin confirms" flow, the same
// trust model the marketplace already uses for buyer/seller order payments
// (see Order.paymentStatus). Swapping this for an automatic collections API
// later only touches the approve step, not this shape.
model SubscriptionPayment {
  id           String                    @id @default(cuid())
  storeId      String
  store        Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  amount       Decimal                   @db.Decimal(12, 2)
  method       String
  reference    String
  periodMonths Int                       @default(1)
  status       SubscriptionPaymentStatus @default(pending)
  note         String                    @default("")
  submittedAt  DateTime                  @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?

  @@index([storeId])
  @@index([status])
}

// Email verification + password reset (item 14). The token itself is never
// stored — only its SHA-256 hash — so a leaked database dump can't be used
// to reset accounts; whoever holds the raw token from the emailed link is
// the only party who can redeem it. See src/mailer.js for how (and whether)
// the email actually gets sent.
enum VerificationTokenType {
  password_reset
  email_verify
}

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
}

// Single-row platform configuration — currently just the mobile money
// merchant codes shown to sellers on subscription.html when they're told
// where to send their subscription payment (see routes/admin.js settings
// endpoints). Always read/written against the fixed id "singleton" rather
// than a real multi-row table, since there is exactly one of these.

// Platform-wide catalog of payment methods a store is allowed to advertise
// at checkout (see `Store.payments` for each seller's own per-method
// opt-in). This is the single source of truth the frontend fetches from
// (`GET /api/payments/methods`) instead of the old hardcoded
// cash/mtnMomo/airtelMoney/card list duplicated across cart-page.js,
// dashboard.js, and orders.js. `isActive` is a platform-wide kill switch
// (e.g. disable a method sitewide during an outage) independent of any
// store's own toggle. `currency` and `allowedCountries` are honest
// scaffolding: NextaStore is single-currency (UGX) and Uganda-only today
// with no other consumer of either field, but they're here so a future
// second market doesn't require another schema migration to add them.
// `environment` ('live' | 'test') lets an admin stage a new method before
// it's customer-facing — GET /api/payments/methods only returns 'test'
// entries outside production (see config.isProd).
model PaymentMethod {
  id               String   @id @default(cuid())
  code             String   @unique
  label            String
  icon             String   @default("fa-money-bill")
  isActive         Boolean  @default(true)
  currency         String   @default("UGX")
  allowedCountries String[] @default(["UG"])
  environment      String   @default("live")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
}

model PlatformSettings {

  id              String   @id @default("singleton")
  mtnMomoCode     String   @default("")
  mtnMomoName     String   @default("NextaStore")
  airtelMoneyCode String   @default("")
  airtelMoneyName String   @default("NextaStore")
  // Admin-editable, plain-language dial steps shown to the seller under
  // "Send by mobile money" once they've picked that network (e.g. "Dial
  // *165*3*171145*<amount>#, enter your PIN, then confirm."). Free text,
  // not validated against the real USSD grammar, so admins can word it
  // however is clearest — including updating it if MTN/Airtel change their
  // menu. Blank means nothing is shown for that method.
  mtnMomoInstructions     String   @default("")
  airtelMoneyInstructions String   @default("")
  supportWhatsappNumber String @default("256761789006")
  supportWhatsappEnabled Boolean @default(true)
  supportContactLabel String @default("NextaStore support team")
  supportHoursNote String @default("")
  updatedAt       DateTime @updatedAt
}

// =============================================================================
// NextaStore Circle + NextaStore Crew: models to PASTE at the end of
// nextastore-backend/prisma/schema.prisma.   (Not wired in yet.)
//
// Design choice: these models point at User, Store and SubscriptionPayment by
// plain string id, with NO Prisma relation and NO foreign key. That means:
//   - not a single existing model has to be edited (no back-relation lines),
//   - the growth tables can be dropped or rebuilt without touching sellers,
//   - the service checks that ids exist itself (service.js does).
// If you would rather have real foreign keys later, add the relation fields then.
//
// ONE more edit is needed elsewhere: add `growth` to `enum NotificationType`
// (see INTEGRATION_GUIDE step 1). The SQL migration already does it.
// =============================================================================

enum GrowthProgram {
  circle
  crew
}

enum GrowthPartnerStatus {
  applied    // Crew members apply and wait for approval; Circle members skip this and start as active
  active
  frozen     // withdrawals paused, new referrals still recorded but held for review
  rejected
  retired    // left the program; history kept
}

enum GrowthUpgradeStatus {
  applied    // a Circle member asked to move to Crew; Circle keeps working while this waits
  approved   // the member is now in Crew (the row stays as the record of when and by whom)
  declined   // Circle carries on exactly as before
  withdrawn  // the member took the request back
}

enum GrowthReferralStage {
  lead             // Crew member logged a prospect who has no account yet
  signed_up
  store_live
  payment_pending  // first payment submitted, awaiting admin approval
  paid             // first payment approved -> commission rows exist
  lapsed           // never paid inside the qualifying window / lead lock ran out
  blocked          // risk engine said block; an admin decides
  void             // not counted (self-referral, duplicate, etc.)
}

enum GrowthCommissionType {
  first_payment
  commitment_kicker
  live_bonus
  campaign_boost
  renewal
  clawback
  adjustment
}

enum GrowthCommissionStatus {
  held       // payment approved, clearance window running
  review     // risk engine wants a human to release it
  available  // cleared, withdrawable
  voided
}

enum GrowthWithdrawalStatus {
  requested
  in_review    // waiting for a second admin or extra checks
  approved
  paid
  rejected
  cancelled
}

enum GrowthFlagStatus {
  open
  dismissed
  confirmed
}

model GrowthPartner {
  id                     String              @id @default(cuid())
  userId                 String              @unique
  program                GrowthProgram
  status                 GrowthPartnerStatus @default(active)
  code                   String              @unique
  displayName            String
  phone                  String              @default("")
  // Crew members only
  rankKey                String              @default("trailhead")
  territories            String[]            @default([])
  kycFileUrl             String?             // ID photo, uploaded through the existing upload path; never shown to other partners
  applicationNote        String              @default("")
  // Crew ID card. The photo is private (same bucket as the ID); the card unlocks by target (rules.js CREW_CARD) or when an admin releases it.
  cardPhotoUrl           String?
  cardIssuedAt           DateTime?
  cardIssuedBy           String?
  approvedBy             String?
  approvedAt             DateTime?
  // Circle -> Crew upgrade. One person is in ONE program at a time; an approved upgrade moves this same row (balances, payout number
  // and history stay) and issues a new Crew code. The old code is kept here so every link already shared keeps working, silently.
  previousCodes          String[]            @default([])
  upgradedAt             DateTime?
  upgradedFrom           GrowthProgram?
  // Payout destination. Changing it starts a withdrawal lock (rules.js WITHDRAWAL.payoutNumberChangeLockHours).
  payoutNetwork          String?
  payoutNumber           String?
  payoutName             String?
  payoutNumberChangedAt  DateTime?
  // Quality and safety
  qualityScore           Int                 @default(70)
  frozenReason           String              @default("")
  frozenAt               DateTime?
  signupIpPrefix         String              @default("")
  usualIpPrefixes        String[]            @default([])
  agreedTermsVersion     String              @default("")
  agreedTermsAt          DateTime?
  joinedAt               DateTime            @default(now())
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  referrals   GrowthReferral[]
  commissions GrowthCommission[]
  withdrawals GrowthWithdrawal[]
  visits      GrowthVisit[]
  flags       GrowthFlag[]
  upgrades    GrowthUpgrade[]

  @@index([program, status])
  @@index([previousCodes], type: Gin)
  @@index([payoutNumber])
}

// A Circle member's request to move up to Crew. The member stays a fully working Circle member until an admin approves it.
model GrowthUpgrade {
  id                 String               @id @default(cuid())
  partnerId          String
  partner            GrowthPartner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  fromProgram        GrowthProgram
  toProgram          GrowthProgram
  status             GrowthUpgradeStatus  @default(applied)
  phone              String               @default("")
  territories        String[]             @default([])
  note               String               @default("")
  kycFileUrl         String?
  cardPhotoUrl       String?
  agreedTermsVersion String               @default("")
  signupIpPrefix     String               @default("")
  appliedAt          DateTime             @default(now())
  reviewedBy         String?
  reviewedAt         DateTime?
  reviewNote         String               @default("")
  oldCode            String               @default("")   // the code before the move (filled on approval)
  newCode            String               @default("")   // the code after the move (filled on approval)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([partnerId, status])
  @@index([status, appliedAt])
}

// One row = one prospect or store that a partner brought (or logged).
model GrowthReferral {
  id                   String              @id @default(cuid())
  partnerId            String
  partner              GrowthPartner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  stage                GrowthReferralStage @default(signed_up)
  // The program the partner was in AT THE MOMENT this person signed up. Set once, never recomputed: it decides which rules
  // (rate, bonuses, campaigns) pay this referral for its whole life, even if the partner later upgrades from Circle to Crew.
  program              GrowthProgram?
  source               String              @default("link")   // link | code | late_claim | lead
  // Who it ended up being (null while still only a lead)
  recruitUserId        String?             @unique
  storeId              String?             @unique            // one referrer per store, enforced by the database
  // Crew member lead details (never shown to other partners)
  leadBusiness         String              @default("")
  leadContactName      String              @default("")
  leadPhone            String              @default("")       // normalised, 256XXXXXXXXX
  leadDistrict         String              @default("")
  leadNote             String              @default("")
  leadLockExpiresAt    DateTime?
  leadLockExtensions   Int                 @default(0)
  // Timeline
  signedUpAt           DateTime?
  storeLiveAt          DateTime?
  paymentSubmittedAt   DateTime?
  firstPaymentId       String?
  paidAt               DateTime?
  qualifyBy            DateTime?                               // signedUpAt + qualifying window
  lastAskedAt          DateTime?                               // last "Ask us to check"
  // Evidence for the risk engine
  signupIpPrefix       String              @default("")
  deviceHash           String              @default("")
  riskDecision         String              @default("clear")  // clear | review | block
  riskScore            Int                 @default(0)
  riskReasons          Json                @default("[]")
  capturedOffline      Boolean             @default(false)   // Crew member logged it with no signal; createdAt holds the time they captured it
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  commissions GrowthCommission[]
  visits      GrowthVisit[]

  @@index([partnerId, stage])
  @@index([partnerId, createdAt])
  @@index([leadPhone])
  @@index([stage, paymentSubmittedAt])
}

// Proof a Crew member really went there. NOT paid for: only used to settle "who found them first"
// disputes and to give admins evidence when a conversion is flagged.
model GrowthVisit {
  id         String         @id @default(cuid())
  partnerId  String
  partner    GrowthPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referralId String
  referral   GrowthReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  note       String         @default("")
  photoUrl   String?
  lat        Float?
  lng        Float?
  visitedAt  DateTime       @default(now())

  @@index([referralId])
  @@index([partnerId, visitedAt])
}

// Credit side of the ledger. Rows are never edited after payout; mistakes are fixed with a
// new `adjustment` or `clawback` row so there is always a trail.
model GrowthCommission {
  id                 String                 @id @default(cuid())
  partnerId          String
  partner            GrowthPartner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referralId         String?
  referral           GrowthReferral?        @relation(fields: [referralId], references: [id], onDelete: SetNull)
  paymentId          String?                                    // SubscriptionPayment.id that triggered it
  paymentReviewedBy  String?                                    // admin who approved that payment (separation of duties)
  type               GrowthCommissionType
  amount             Int                                         // UGX, signed (clawbacks are negative)
  status             GrowthCommissionStatus @default(held)
  clearsAt           DateTime?
  releasedBy         String?
  releasedAt         DateTime?
  voidReason         String                 @default("")
  note               String                 @default("")
  createdAt          DateTime               @default(now())

  @@index([partnerId, status])
  @@index([status, clearsAt])
  @@index([referralId])
  @@unique([paymentId, partnerId, type])   // the same approval can never pay the same line twice
}

// Debit side of the ledger.
model GrowthWithdrawal {
  id                  String                 @id @default(cuid())
  partnerId           String
  partner             GrowthPartner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount              Int
  network             String
  payoutNumber        String                                      // snapshot at request time
  payoutName          String                 @default("")
  status              GrowthWithdrawalStatus @default(requested)
  requestedAt         DateTime               @default(now())
  dueBy               DateTime                                    // 2 working days promise
  needsSecondApproval Boolean                @default(false)
  approvedBy          String?
  approvedAt          DateTime?
  paidBy              String?
  paidAt              DateTime?
  payoutReference     String                 @default("")         // the MoMo transaction ID the admin paid with
  feeEstimate         Int                    @default(0)          // planning estimate of the mobile money fee NextaStore pays
  feeActual           Int?                                        // the real fee, entered by the admin who paid
  rejectReason        String                 @default("")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([partnerId, status])
  @@index([status, dueBy])
  @@index([partnerId, requestedAt])
}

model GrowthFlag {
  id         String           @id @default(cuid())
  partnerId  String
  partner    GrowthPartner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referralId String?
  code       String
  severity   String           @default("medium")   // low | medium | high
  detail     Json             @default("{}")
  status     GrowthFlagStatus @default(open)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([partnerId, status])
  @@index([status, createdAt])
}

// Admin-created pushes: a commission boost for a window, or a "Market Day" for a district.
model GrowthCampaign {
  id           String         @id @default(cuid())
  title        String
  description  String         @default("")
  program      GrowthProgram?                    // null = both
  district     String         @default("")       // "" = everywhere
  boostPercent Int            @default(0)        // extra % on the main commission of conversions that PAY in the window
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean        @default(true)
  createdBy    String?
  createdAt    DateTime       @default(now())

  @@index([isActive, startsAt, endsAt])
}

model GrowthSettings {
  id             String   @id @default("singleton")
  circleOpen     Boolean  @default(false)   // false = no new Circle sign-ups (existing keep earning). Starts CLOSED: open it from the admin (Campaigns > Program settings) when ready.
  crewOpen       Boolean  @default(false)   // same for Crew applications
  extraHolidays  String[] @default([])      // 'YYYY-MM-DD', e.g. Eid dates once announced
  termsVersion   String   @default("2026-10-draft")
  updatedAt      DateTime @updatedAt
}
