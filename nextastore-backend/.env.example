# Example only; replace credentials for your deployment.
# PostgreSQL connection URL. Keep connection_limit tuned for your deployment pool.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?connection_limit=10"

# --- NextaStore Circle / Crew (growth program) ---------------------------------------------------
# Crew members' ID photos go to a SEPARATE R2 bucket with public access OFF (never the public one).
# Not set = Crew applications answer "uploads are not set up" and nothing is saved publicly.
R2_PRIVATE_BUCKET_NAME=
# Default (unset) keeps /circle, /crew and /invite on the main site. To move them to circle. and crew.
# subdomains, set both (the server refuses to start with a half-written setup; see
# docs/growth-program/03_INTEGRATION_GUIDE.md, "Subdomains"):
# GROWTH_MODE=subdomain
# GROWTH_ROOT_DOMAIN=nextastores.com
# Hourly earnings/lead sweep. Running more than one backend instance? Set "off" on all but one.
# GROWTH_SWEEP=on
