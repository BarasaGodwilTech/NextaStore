# Copy this file to .env and fill in real values before deploying.
# In production, set these as real environment variables / secrets in your
# host's dashboard (Railway/Render/Fly all have one) — never a checked-in .env.

# development | production. Several safety checks (see src/config.js) only
# activate when this is "production" — e.g. refusing to boot with a wildcard
# CORS_ORIGIN or a missing JWT_SECRET.
NODE_ENV=development

# Port the API server listens on
PORT=4000

# PostgreSQL connection string, e.g. from Supabase/Neon/Railway/RDS.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
#
# Under concurrent load, also set Prisma's own pool tuning params on this
# same URL (append with `&` if you already have `?sslmode=require` etc.):
#   ?connection_limit=10&pool_timeout=20
# Why this matters: Prisma's default pool size is (num_physical_cpus * 2 + 1)
# — on a small 1-2 vCPU container that's only 3-5 connections, which becomes
# a bottleneck the moment several requests land at once (each one queues for
# a free connection instead of running immediately). connection_limit sets
# an explicit, larger pool; pool_timeout (seconds) controls how long a
# request waits for a free connection before failing, so a spike degrades
# gracefully (fast error) instead of queuing forever.
# If you ever run more than one instance of this backend (horizontal
# scaling), each instance opens its own pool of this size — make sure
# instance_count * connection_limit stays under your Postgres provider's
# max_connections, or use a connection pooler (e.g. Railway/Supabase's
# built-in PgBouncer endpoint) in front of Postgres instead of connecting
# every instance directly.
DATABASE_URL=postgresql://user:password@localhost:5432/nextastore?connection_limit=10&pool_timeout=20

# Redis connection string, e.g. redis://default:password@host:6379.
# Optional in development and for a single instance — leave unset and both
# the rate limiter and the public-catalog cache fall back to safe in-memory,
# per-instance behavior (see src/cache.js). Required once you run more than
# one backend instance, or rate limits and cached responses silently stop
# being shared across them.
REDIS_URL=

# Secret used to sign JWT auth tokens — generate a long random string for
# production, e.g. `openssl rand -hex 32`. Never commit your real value.
JWT_SECRET=change-this-to-a-long-random-string

# How long an issued auth token stays valid
# Session lifetimes. IMPORTANT: use a unit suffix ("30d", "12h", "2d") or a
# plain number of SECONDS (172800). A bare number is interpreted as seconds
# by the app, but do NOT hand these straight to jsonwebtoken elsewhere — it
# reads bare numeric strings as milliseconds, which is how a "86400" here
# once produced 86-second sessions.
# How long a "Remember me" login lasts. 14-30 days is standard for an
# e-commerce/storefront login (Amazon/Shopify/Etsy-style); going much
# beyond that trades away security for little real convenience:
JWT_REMEMBER_EXPIRES_IN=30d
# How long a normal (unticked) login lasts, sliding (renewed on activity —
# see attachRenewedToken in src/middleware.js). 24h is the conventional
# default for a non-persistent session:
JWT_SESSION_EXPIRES_IN=24h

# Comma-separated list of origins allowed to call this API from a browser.
# Use * only for local development — production boot will refuse to start
# with CORS_ORIGIN unset or "*".
CORS_ORIGIN=*

# Public base URL of this API. Currently only used to build absolute links
# in emails if needed; image URLs now come from R2 (see below), not this.
PUBLIC_URL=

# Base URL of the static frontend (the http-server on :3000 in dev). Used to
# build links that go into emails — password reset and email verification —
# since those need an absolute URL a recipient can click from their inbox.
FRONTEND_URL=http://localhost:3000

# Public origin search engines and WhatsApp/Facebook link previews see: the
# host serving /s/<store-slug>, /sitemap.xml and /robots.txt. In production
# this is normally identical to FRONTEND_URL (e.g. https://nextastore.ug) and
# your reverse proxy/CDN must forward those three paths to this API (see
# README "Search engine visibility"). Leave unset in development: it defaults
# to this server (http://localhost:4000) so /s/<slug> opens directly.
SITE_URL=

# Cloudflare R2 (S3-compatible) bucket for product/store/avatar images.
# All five are required — there is no local-disk fallback. Get these from
# the Cloudflare dashboard: R2 > your bucket > Settings, and R2 > Manage API
# tokens for the access key pair. R2_PUBLIC_URL is either the bucket's
# public r2.dev URL or a custom domain you've connected to it.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nextastore
R2_PUBLIC_URL=

# Outbound email (password reset / email verification links — see
# src/mailer.js). Leave SMTP_HOST unset in development: emails are logged to
# the server console instead of sent, which is enough to grab a reset/verify
# link for local testing without a real mail provider. Set all of these to
# actually send email — most SMTP-compatible providers (SES, Postmark,
# Resend, Mailgun, even Gmail's SMTP relay) work here.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NextaStore <no-reply@nextastore.ug>

# Web Push (mobile/desktop push notifications — see src/push.js,
# service-worker.js, js/push.js). Optional: leave these unset and the app
# runs fine, it just never shows the "turn on notifications" prompt and
# never sends a push. Generate a real pair per environment with
# `npm run generate:vapid-keys` — do not reuse the same pair across dev,
# staging and production, and never commit real keys here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@nextastore.ug
