# =====================================================================================
# NextaStore environment configuration: EXAMPLE / TEMPLATE
# Copy to ".env" and fill in your own values. This file is safe to commit: no real secrets.
# =====================================================================================

# --- Server ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# --- Database (PostgreSQL) ------------------------------------------------------------
# Use a DIRECT (non-pooled) connection for `prisma migrate`.
# connection_limit = size of Prisma's pool; tune it to your deployment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&connect_timeout=30&connection_limit=10"

# --- Auth (JWT) -----------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_REMEMBER_EXPIRES_IN=30d
JWT_SESSION_EXPIRES_IN=24h

# --- URLs / CORS ----------------------------------------------------------------------
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:3000,https://your-frontend-domain.com
PUBLIC_URL=https://your-public-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# --- Cloudflare R2 storage ------------------------------------------------------------
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-<HASH>.r2.dev
# Crew members' ID photos go to a SEPARATE bucket with public access OFF (never the public one).
# Not set = Crew applications answer "uploads are not set up" and nothing is saved publicly.
R2_PRIVATE_BUCKET_NAME=

# --- Sign-in: Google ------------------------------------------------------------------
# Web client ID from Google Cloud Console (APIs & Services > Credentials), looks like
# 1234567890-abc123.apps.googleusercontent.com. Public, safe to expose to the browser.
# Empty = the "Continue with Google" button does not appear. Several? Separate with commas.
# Step by step: docs/AUTH_SETUP.md
GOOGLE_CLIENT_ID=

# --- Email (verification + password-reset messages) -----------------------------------
# Without SMTP_HOST the server only PRINTS emails to its log.
# Production refuses to start without SMTP_HOST and SMTP_FROM.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NextaStore <no-reply@example.com>"

# --- Web Push (VAPID) -----------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Growth program: NextaStore Circle / Crew -----------------------------------------
# Default (unset) keeps /circle, /crew and /invite on the main site. To move them to circle.
# and crew. subdomains, set BOTH of the next two (the server refuses to start with a
# half-written setup; see docs/growth-program/03_INTEGRATION_GUIDE.md, "Subdomains").
# GROWTH_MODE=subdomain
# GROWTH_ROOT_DOMAIN=example.com
# Hourly earnings/lead sweep. Running more than one backend instance? Set "off" on all but one.
# GROWTH_SWEEP=on

# --- Staff Console (/staff): completely separate from shopper accounts ----------------
# REQUIRED in production, and the server refuses to start without them. Both are random,
# at least 32 characters, and must NOT equal JWT_SECRET or each other.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STAFF_SECRET=replace-with-a-different-long-random-string-at-least-32-chars
# Encrypts every staff member's authenticator secret at rest. Rotating it forces re-enrolment.
STAFF_MFA_KEY=replace-with-another-long-random-string-at-least-32-chars
# Name shown in the authenticator app.
# STAFF_MFA_ISSUER=NextaStore Staff
# Origins allowed to call /api/staff with the session cookie (comma-separated, exact match). Same-origin console: leave blank.
# STAFF_ORIGINS=https://staff.example.com
# Public address of the console (used in invitation and reset emails).
# STAFF_CONSOLE_URL=https://staff.example.com
# Optional: only these IPs/CIDRs may reach /api/staff at all (comma-separated). Strongly recommended behind a VPN/office IP.
# STAFF_IP_ALLOWLIST=203.0.113.10,198.51.100.0/24
# Leave unset in production (cookie is Secure). Set "false" ONLY for plain-http local development.
# STAFF_COOKIE_SECURE=false

# --- Staff Console: risk-based two-step verification and PIN ---
# Days a browser stays "remembered" after a verified authenticator code (a new browser, an expired one or a suspicious sign-in always asks for the code).
STAFF_DEVICE_TRUST_DAYS=30
# Roles at or above this rank enter the code on EVERY sign-in (100 = Super Admin only, 0 = no exception).
STAFF_MFA_ALWAYS_RANK=100
# Wrong PINs before the PIN locks, and for how long.
STAFF_PIN_LOCKOUT_ATTEMPTS=5
STAFF_PIN_LOCKOUT_MINUTES=15
