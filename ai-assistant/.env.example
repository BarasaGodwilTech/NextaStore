# =====================================================================
#  NextaStore AI assistant (Nexi) - settings
# =====================================================================
#  Everything runs on THIS machine. Nothing is sent to an outside AI or
#  translation service.
#  1. Choose your chat model below (it is the only model the assistant needs).
#  2. Save this file, then double-click start.bat.
#  start.bat downloads any model written here that is not installed yet.
#
#  Rules: one setting per line, no spaces around the "=" sign, and keep
#  comments on their own line (a line that starts with #).
# =====================================================================


# ---------------------------------------------------------------------
#  1. CHAT MODEL (required): the "brain" that writes the answers.
#     Pick ONE. Bigger = smarter, but slower and needs more memory.
#     It does not need to know NextaStore facts: those come from the
#     knowledge files in src/knowledge/, which it reads on every question.
#     Sizes are rough download sizes.
#
#       qwen2.5:1.5b-instruct  about 1 GB     4 GB RAM / CPU only. Light and fast (the default).
#       qwen2.5:3b-instruct    about 2 GB     8 GB RAM / CPU only. Fast, a bit sharper.
#       llama3.2:3b            about 2 GB     Small alternative, more English-centred.
#       qwen2.5:7b-instruct    about 4.7 GB   16 GB RAM or a recent GPU. Best balance.
#       llama3.1:8b            about 4.9 GB   Alternative to the 7B if you prefer Llama.
#       qwen2.5:14b-instruct   about 9 GB     Strong GPU (16 GB VRAM) or a real server.
# ---------------------------------------------------------------------
CHAT_MODEL=qwen2.5:1.5b-instruct


# ---------------------------------------------------------------------
#  2. KNOWLEDGE SEARCH (optional)
#     The default is keyword search inside the assistant itself:
#     no extra model, no index file, no "reindex" step. Add or edit a file
#     in src/knowledge/ and it is live within a second or two.
#     For Luganda and Swahili questions it also uses the word list in
#     src/lang/retrieval-lexicon.json.
#
#     RETRIEVAL=hybrid adds embedding similarity (needs the EMBED_MODEL
#     below, about 1.2 GB, plus `npm run reindex` after knowledge edits).
#     Most people should leave this alone.
# ---------------------------------------------------------------------
# RETRIEVAL=bm25
# EMBED_MODEL=bge-m3


# ---------------------------------------------------------------------
#  3. LUGANDA REPLIES (optional)
#     Option A: Ganda Gemma 1B, runs on THIS machine (about 1 GB), nothing
#               is sent anywhere. Leave the line below as it is.
#               On a 4 GB machine this is probably too much memory:
#               empty GANDA_MODEL and the assistant answers Luganda
#               questions in English with a short note.
#     Option B: empty GANDA_MODEL. Luganda questions get an English answer
#               with a short note (common questions still get the curated
#               Luganda answer from the phrasebook).
#     LUGANDA_PROVIDER: auto (default), local or off.
#     With "off", start.bat does not download Ganda Gemma.
# ---------------------------------------------------------------------
GANDA_MODEL=crane-ai-labs/ganda-gemma-1b:q4-k-m
LUGANDA_PROVIDER=auto
# WIP 69: translate Luganda sentences WHILE the English answer is still streaming.
# Leave this false. Set it to true only after OLLAMA_MAX_LOADED_MODELS=2 is set AND the machine has enough
# RAM for both models (chat model + Ganda model). Measure first (free -m, ollama ps, npm run bench).
LUGANDA_INTERLEAVE=false


# ---------------------------------------------------------------------
#  4. WHERE THINGS RUN (the defaults are right for testing on your PC)
# ---------------------------------------------------------------------
PORT=4100
# 127.0.0.1 = only this PC can reach the assistant (the NextaStore backend
# talks to it from the same PC). Keep the assistant private.
HOST=127.0.0.1
# Must match ASSISTANT_TOKEN in nextastore-backend/.env if you set one there.
ASSISTANT_TOKEN=
# Where Ollama is listening. Leave as is for Ollama on this PC.
OLLAMA_HOST=http://127.0.0.1:11434
# The NextaStore backend (used for live facts such as which payment methods are on).
NEXTASTORE_API_BASE=http://localhost:4000/api
# How often the assistant copies the platform rules (Seller Pass price, trial days, cancel rule, order statuses...)
# from that backend into its knowledge. Milliseconds; default 300000 (5 minutes); 0 turns it off.
# If the backend is down it keeps the last saved copy.
FACTS_SYNC_MS=300000
# How long Ollama keeps the chat model in memory after the last question
# (e.g. 30m). -1 = never unload.
OLLAMA_KEEP_ALIVE=30m


# ---------------------------------------------------------------------
#  5. REVIEW LOGS (stay on this PC only, in the "data" folder)
#     Turn on while testing. See README: npm run flags / npm run lg:misses
# ---------------------------------------------------------------------
LOG_FLAGGED_MESSAGES=true
LOG_LUGANDA_MISSES=true


# ---------------------------------------------------------------------
#  6. SPEED / LIMITS (optional). Remove the # to change one.
#     The values shown are the project defaults. On a slow PC try
#     MAX_REPLY_TOKENS=250 and MAX_CONCURRENT=1.
# ---------------------------------------------------------------------
# MAX_REPLY_TOKENS=380
# MAX_REPLY_TOKENS_LG=220
# MAX_CONCURRENT=2
# MAX_QUEUE=30
# How long (milliseconds) someone may wait in line before getting a friendly "busy, try again".
# QUEUE_WAIT_MS=45000
# Greetings / thanks / "who are you": written by the model on a short prompt.
# SMALLTALK_MAX_TOKENS=90
# SMALLTALK_TEMPERATURE=0.7
# RAG_TOP_K=3
# HISTORY_TURNS=6

# WIP 71: real product/store cards in Nexi.
NEXI_CATALOG_CARDS=true
CATALOG_TIMEOUT_MS=2500
